# Ablation (a'): upstream vLLM with its own selective UVA weight offload of the expert parameters
# (vllm/config/offload.py at 36768d1). UVA_GIB is per GPU.
MODEL=orig
QUANT=
PLUGINS=
ENGRAM_INT4=0
UVA_GIB=${UVA_GIB:-75}
EXTRA_ARGS="--offload-backend uva --cpu-offload-gb $UVA_GIB --cpu-offload-params experts"

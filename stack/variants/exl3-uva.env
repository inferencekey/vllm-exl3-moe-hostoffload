# Ablation (c0): minimal EXL3 support plus upstream vLLM's selective UVA offload of the expert parameters. Layer
# (parameter-tensor) granularity, no hot/cold split, no side stream. UVA_GIB is per GPU; to match a plan's host
# bytes use: python3 -m hostoffload.weights.plan bytes --plan <plan.json>.
MODEL=exl3
QUANT=exl3
PLUGINS=vllm_exl3
ENGRAM_INT4=1
UVA_GIB=${UVA_GIB:-30}
EXTRA_ARGS="--offload-backend uva --cpu-offload-gb $UVA_GIB --cpu-offload-params experts"
# without Diffbot's hooks the sparse-attention backends accept only 128 (first UVA boot, 2026-10-06)
BLOCK_SIZE=128
